# Copier en .env et remplir. Le .env n'est jamais committé (§9 du protocole).
# Ce fichier ne contient que des noms de variables et des valeurs factices.

# --- Modèle frontier : gpt-6-astra via l'API OpenAI ---
OPENAI_API_KEY=sk-remplacer-par-votre-cle
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Référence IA : Gemini, modèle tiers (docs/AI_REFERENCE.md) ---
GEMINI_API_KEY=remplacer-par-votre-cle

# --- Modèle local : qwen2.5:14b via Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Tracing des appels LLM ---
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Réception des pitchs : Input_Telegram_Mail/input_listener.py ---
# Jeton du bot, donné par @BotFather.
TELEGRAM_TOKEN=123456789:remplacer-par-le-jeton-du-bot
# Boîte dédiée, relevée en IMAP, accusés en SMTP (serveurs dans config.json).
# Gmail : activer la validation en deux étapes et créer un mot de passe d'application.
MAIL_ADRESSE=pitchs@example.com
MAIL_MOT_DE_PASSE=remplacer-par-le-mot-de-passe-d-application
