# Copier en .env et remplir. Le .env n'est jamais committé (§9 du protocole).
# Ce fichier ne contient que des noms de variables et des valeurs factices.

# --- Modèle frontier : gpt-6-astra via l'API OpenAI ---
OPENAI_API_KEY=sk-remplacer-par-votre-cle
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Modèle local : deepseek-r1:8b via Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Tracing des appels LLM ---
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Ingestion Telegram : jeton donné par @BotFather ---
TELEGRAM_BOT_TOKEN=123456789:remplacer-par-le-jeton-du-bot

# --- Ingestion e-mail : boîte dédiée, relevée en IMAP, accusés en SMTP ---
# Gmail : activer la validation en deux étapes et créer un mot de passe d'application.
EMAIL_ADDRESS=pitchs@example.com
EMAIL_PASSWORD=remplacer-par-le-mot-de-passe-d-application
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
